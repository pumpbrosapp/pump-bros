# Copy this file to .env and fill in your own Supabase project's values.
# Project Settings -> API in your Supabase dashboard.
# See config/supabase.ts for full setup instructions.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Crash/error reporting via Sentry — leave blank to skip it
# (errors just log to the console instead). Settings -> Client Keys (DSN)
# in your Sentry project. See lib/errorReporting.ts for details.
EXPO_PUBLIC_SENTRY_DSN=
